{
  "name": "@taskmarket/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./abi": "./abi/index.ts"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "scripts": {
    "build:sol": "forge build",
    "generate-abi": "tsx scripts/generate-abi.ts",
    "type-check": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "forge test -j 1",
    "test:ci": "npm run test:hook-starter && npm run test:hook-manifest && FOUNDRY_PROFILE=ci forge test -j 1",
    "test:hook-starter": "npm --prefix packages/create-taskmarket-hook test",
    "test:hook-manifest": "node --test tools/hook-manifest/test/*.test.mjs",
    "validate:hook-manifest": "node tools/hook-manifest/validate.mjs",
    "test:gas": "forge test -j 1 --gas-report",
    "coverage": "forge coverage --report lcov && genhtml lcov.info --output-directory reports/coverage",
    "coverage:summary": "forge coverage --report summary",
    "snapshot": "forge snapshot",
    "snapshot:check": "forge snapshot --check",
    "doc": "forge doc --out docs/natspec",
    "lint": "solhint 'src/**/*.sol'",
    "lint:check": "solhint 'src/**/*.sol'",
    "format:check": "forge fmt --check",
    "format:write": "forge fmt",
    "audit": "slither . --config-file slither.config.json",
    "deploy:local": "forge script script/DiamondDeploy.s.sol:DiamondDeploy --rpc-url localhost --broadcast",
    "deploy:base-sepolia": "forge script script/DiamondDeploy.s.sol:DiamondDeploy --rpc-url base_sepolia --broadcast --verify",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "solhint": "^6.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
