{
  "name": "@taskmarket/contracts",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./abi": "./abi/index.ts"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge test",
    "test:gas": "forge test --gas-report",
    "coverage": "forge coverage --report lcov && genhtml lcov.info --output-directory reports/coverage",
    "coverage:summary": "forge coverage --report summary",
    "snapshot": "forge snapshot",
    "snapshot:check": "forge snapshot --check",
    "doc": "forge doc --out docs/natspec",
    "lint": "solhint 'src/**/*.sol'",
    "lint:check": "solhint 'src/**/*.sol'",
    "format:check": "forge fmt --check",
    "format:write": "forge fmt",
    "audit": "slither . --config-file slither.config.json",
    "deploy:local": "forge script script/DiamondDeploy.s.sol:DiamondDeploy --rpc-url localhost --broadcast",
    "deploy:base-sepolia": "forge script script/DiamondDeploy.s.sol:DiamondDeploy --rpc-url base_sepolia --broadcast --verify",
    "clean": "forge clean"
  },
  "devDependencies": {
    "solhint": "^6.2.1"
  }
}
